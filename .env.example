# ── Microsoft Foundry ────────────────────────────────────────────────────────
# Endpoint del recurso (sirve también la URL del proyecto: solo se usa el origin).
FOUNDRY_ENDPOINT=https://<tu-recurso>.services.ai.azure.com
# `entra` = sin clave: token de Entra ID (az login en local, identidad administrada en Azure).
# Cualquier otro valor se envía como cabecera `api-key`.
FOUNDRY_API_KEY=entra
# Nombres de los despliegues en Foundry.
MODEL_REALTIME=gpt-realtime-2.1
MODEL_DECISION=Decision-1
MODEL_IMAGE=gpt-image-2.5-sunburst
# Opcional: despliegue de transcripción (p. ej. gpt-4o-mini-transcribe). Con él se
# muestra lo que dijo el usuario y Decision-1 recibe también su texto.
MODEL_REALTIME_TRANSCRIBE=
# Opcional: client id de la identidad administrada (solo en Azure).
AZURE_CLIENT_ID=

# ── Marca ───────────────────────────────────────────────────────────────────
# Carpeta dentro de brands/ con el nombre, los colores, los textos y el avatar.
# `default` es la de marca blanca. Una marca propia va en brands/<nombre>/, que
# git ignora.
ASSISTANT_BRAND=default

# ── Sesión ───────────────────────────────────────────────────────────────────
# Secreto HS256 de la cookie de sesión (32 caracteres o más).
ASSISTANT_SESSION_SECRET=
ASSISTANT_SESSION_MAX_AGE_S=28800
# URL pública de la app (para el login web). Vacío = el origin de la petición.
ASSISTANT_PUBLIC_URL=
# `true` fuerza cookies SameSite=None; Secure; Partitioned (iframe de Teams). En producción ya es así.
ASSISTANT_COOKIE_CROSS_SITE=

# ── Entrada de pruebas ───────────────────────────────────────────────────────
# `true` muestra "Entrar como usuario de pruebas". Se ignora con NODE_ENV=production.
ASSISTANT_TEST_LOGIN_ENABLED=true

# ── Microsoft Entra ID (OAuth web + SSO de Teams) ────────────────────────────
# Los imprime `pnpm entra:register <FQDN>`. Sin ENTRA_CLIENT_ID solo hay entrada de pruebas.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_APP_ID_URI=
ENTRA_CLIENT_SECRET=

# ── Teams ────────────────────────────────────────────────────────────────────
# Host público (sin https://) que usa el manifest de Teams.
ASSISTANT_PUBLIC_FQDN=
# Lista separada por espacios; vacío = dominios de Teams y Microsoft 365.
ALLOWED_FRAME_ANCESTORS=
